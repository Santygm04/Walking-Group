# Gmail SMTP (usar una contraseña de aplicación de Gmail, no la contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=contraseña-de-aplicacion-de-16-caracteres
SMTP_FROM=tu-cuenta@gmail.com

# Admin: login y notificaciones
ADMIN_EMAIL=santiagogilmina2@gmail.com
ADMIN_PASSWORD=cambia-esta-contrasena-por-una-larga-y-segura
# Opcional: hash scrypt en lugar de ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=scrypt$...
# Opcional: separar la clave de sesiones de la de confirmación
# ADMIN_SESSION_SECRET=otra-clave-larga-y-aleatoria

# Email visible en los correos
CONTACT_EMAIL=panaxxx@hotmail.com

# URL pública del sitio
SITE_URL=https://walking-group.vercel.app

# Clave larga y aleatoria para firmar los links de confirmación
CONFIRMATION_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Base de datos Redis para el panel (Vercel Storage / Upstash)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# También se aceptan:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
