# Gmail SMTP (usar una contraseña de aplicación de Gmail, no la contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=contraseña-de-aplicacion-de-16-caracteres

# Email que recibe las solicitudes y confirma reuniones
ADMIN_EMAIL=tu-cuenta@gmail.com
# Email visible en los correos
CONTACT_EMAIL=panaxxx@hotmail.com
# Remitente (por defecto usa SMTP_USER)
SMTP_FROM=tu-cuenta@gmail.com

# URL pública del sitio
SITE_URL=https://walking-group.vercel.app

# Clave larga y aleatoria para firmar los links de confirmación
CONFIRMATION_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
